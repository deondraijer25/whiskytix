    "@mollie/api-client": "^4.0.0",
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/supabase-js": "^2.49.0",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.4",
    "fastify": "^5.2.1",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.16.0",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.5",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
