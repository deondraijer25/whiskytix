# Whiskytix Omgevingsvariabelen
PORT=4000
NODE_ENV=development

# Supabase (PostgreSQL)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Mollie API Keys (Multi-Organisatie: Gent vs Den Haag)
MOLLIE_API_KEY_LIVE=live_...
MOLLIE_API_KEY_TEST=test_...
MOLLIE_ENVIRONMENT_GENT=live
MOLLIE_API_KEY_LIVE_GENT=live_...
MOLLIE_API_KEY_TEST_GENT=test_...
MOLLIE_ENVIRONMENT_DENHAAG=test
MOLLIE_API_KEY_TEST_DENHAAG=test_...
MOLLIE_API_KEY_LIVE_DENHAAG=live_...

# Scanner Cryptografie
SCANNER_HMAC_SECRET=whiskytix_super_secret_signing_key_2026

# E-mail Service (Resend / Postmark)
RESEND_API_KEY=re_...
FROM_EMAIL=tickets@whiskyfestival.nl

# Conscribo REST API — International Whisky Society (IWS)
CONSCRIBO_ACCOUNT_NAME=iws
CONSCRIBO_API_USER=LeadFab
CONSCRIBO_API_PASSPHRASE=your-conscribo-passphrase
CONSCRIBO_API_VERSION=1.20260414
